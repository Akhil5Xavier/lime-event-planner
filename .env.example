# Copy to .env and fill in. Used by docker compose (production) and by the backend when run locally.
# Never commit .env.

# --- Required for docker compose ---------------------------------------------

# Public host name of the app, e.g. events.stuttgart.example.com (DNS must point at the server).
# Use "localhost" to test the whole stack on your own machine.
DOMAIN=localhost

# Long random string; signs login tokens. The API refuses to start in production without one.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Postgres password (also used by the backup service).
POSTGRES_PASSWORD=change-me

# --- Data sources ------------------------------------------------------------

# Free key from https://developer.ticketmaster.com (My Apps -> Consumer Key).
TICKETMASTER_API_KEY=

# Optional, paid: https://www.predicthq.com (adds attendance predictions).
PREDICTHQ_TOKEN=

# Nightly sync time (cron, Europe/Berlin) and how far ahead to fetch.
INGEST_CRON=0 3 * * *
INGEST_DAYS_AHEAD=90

# --- AI assistant (free) -------------------------------------------------------
# Any OpenAI-compatible Chat Completions API. The assistant is off until LLM_API_KEY is
# set (or LLM_BASE_URL points at a local Ollama). Pick ONE block; the model must support
# tool/function calling.
#
# Groq free tier (default): free key at https://console.groq.com/keys, no credit card.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
#
# Google Gemini free tier: free key at https://aistudio.google.com/apikey
# (on the free tier Google may use prompts to improve its products).
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash
# LLM_API_KEY=
#
# Hugging Face (small free monthly credits): token at https://huggingface.co/settings/tokens
# LLM_BASE_URL=https://router.huggingface.co/v1
# LLM_MODEL=<a model with tool calling, e.g. from huggingface.co/inference/models>
# LLM_API_KEY=hf_...
#
# Ollama, fully local and private (no key): https://ollama.com, then `ollama pull qwen3:4b`
# (127.0.0.1, not localhost: on Windows "localhost" tries IPv6 first and adds ~2 s per call)
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen3:4b

# --- Monitoring ----------------------------------------------------------------

# Slack-compatible incoming webhook. Gets a message when a sync fails or finds 0 events.
ALERT_WEBHOOK_URL=

# Optional Sentry error reporting (backend at runtime, frontend at build time).
SENTRY_DSN=
VITE_SENTRY_DSN=

# --- Tuning --------------------------------------------------------------------

# Share of visitors expected to ride, the cap per hotspot, and the hotspot grouping radius.
SCOOTER_SHARE=0.005
MAX_SCOOTERS_PER_SPOT=150
HOTSPOT_RADIUS_M=600

# Days of database backups to keep, API worker processes, days of past events to keep.
BACKUP_KEEP_DAYS=14
WEB_CONCURRENCY=2
EVENT_RETENTION_DAYS=365

# Local development only (backend on SQLite, frontend on Vite):
# DATABASE_URL=sqlite:///./lime_events.db
