# Copy to .env and fill in. Used by docker compose (production) and by the backend when run locally.
# Never commit .env.

# --- Required for docker compose ---------------------------------------------

# Public host name of the app, e.g. events.stuttgart.example.com (DNS must point at the server).
# Use "localhost" to test the whole stack on your own machine.
DOMAIN=localhost

# Long random string; signs login tokens. The API refuses to start in production without one.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Postgres password (also used by the backup service).
POSTGRES_PASSWORD=change-me

# --- Data sources ------------------------------------------------------------

# Free key from https://developer.ticketmaster.com (My Apps -> Consumer Key).
TICKETMASTER_API_KEY=

# Optional, paid: https://www.predicthq.com (adds attendance predictions).
PREDICTHQ_TOKEN=

# Nightly sync time (cron, Europe/Berlin) and how far ahead to fetch.
INGEST_CRON=0 3 * * *
INGEST_DAYS_AHEAD=90

# --- Monitoring ----------------------------------------------------------------

# Slack-compatible incoming webhook. Gets a message when a sync fails or finds 0 events.
ALERT_WEBHOOK_URL=

# Optional Sentry error reporting (backend at runtime, frontend at build time).
SENTRY_DSN=
VITE_SENTRY_DSN=

# --- Tuning --------------------------------------------------------------------

# Share of visitors expected to ride, the cap per hotspot, and the hotspot grouping radius.
SCOOTER_SHARE=0.005
MAX_SCOOTERS_PER_SPOT=150
HOTSPOT_RADIUS_M=600

# Days of database backups to keep, API worker processes, days of past events to keep.
BACKUP_KEEP_DAYS=14
WEB_CONCURRENCY=2
EVENT_RETENTION_DAYS=365

# Local development only (backend on SQLite, frontend on Vite):
# DATABASE_URL=sqlite:///./lime_events.db
