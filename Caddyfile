# HTTPS entry point. Caddy gets and renews a Let's Encrypt certificate for $DOMAIN automatically
# (DNS must point at this server and ports 80/443 must be reachable). With DOMAIN=localhost it
# uses its own local certificate instead, for testing.
{$DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy frontend:80
}
